<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/funContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/nativeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开屏广告" />

            <Button
                android:id="@+id/btnInter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插页广告" />

            <Button
                android:id="@+id/btnReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="激励广告" />

            <Button
                android:id="@+id/btnSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置" />

            <app.allever.android.lib.basic.ui.widget.LeftCountView
                android:id="@+id/leftCountView"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnFloatConsumeCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="执行消耗次数功能" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnPremiumContainer"
                android:layout_gravity="center_horizontal"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="24dp"
                android:background="@drawable/floating_btn_bg"
                android:elevation="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/setting_btn_start"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/setting_btn_start"
                app:layout_constraintTop_toTopOf="@+id/setting_btn_start">

                <TextView
                    android:id="@+id/tvPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnRecommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="推荐功能" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>