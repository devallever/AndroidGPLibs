<?xml version="1.0" encoding="utf-8"?>
<!-- Plan 列表 item -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/bg_plan_unselected">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/billing_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Monthly"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/tvPlanPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/billing_text_price"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="US$2.99/mo"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <!-- 勾选容器 -->
    <FrameLayout
        android:id="@+id/flCheck"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center">

        <View
            android:id="@+id/viewCircle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_plan_uncheck" />

        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_check_white"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
