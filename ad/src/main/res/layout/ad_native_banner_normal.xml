<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_native_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#eeeeee">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- Icon circle with purple label background -->
        <FrameLayout
            android:id="@+id/ad_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="ad"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1" />

        </FrameLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/vc_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/ad_body"
            app:layout_constraintEnd_toStartOf="@id/ad_cta"
            app:layout_constraintStart_toEndOf="@id/ad_icon_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Test Ad: Google Ads" />

        <!-- Body: allow up to 2 lines -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/vc_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ad_cta"
            app:layout_constraintStart_toEndOf="@id/ad_icon_container"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            app:layout_constraintVertical_bias="0"
            tools:text="Google Ads helps you stay connected to your mobile app users" />

        <!-- CTA button: gradient capsule, matches Escape button style -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vc_btn_escape_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="96dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Install" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Ad badge: small pill at top-left corner -->
    <TextView
        android:id="@+id/ad_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#ff0000"
        android:layout_gravity="start"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:text="Ad"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

</com.google.android.gms.ads.nativead.NativeAdView>
