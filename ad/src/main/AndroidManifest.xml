<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Include required permissions for Advertising Id -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <meta-data android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <activity android:name="com.allever.android.lib.admob.AdActivity"
            android:screenOrientation="portrait"/>

        <activity
            android:name="com.allever.android.lib.ad.LocalAdDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RecommendProject" />

        <activity
            android:name="com.allever.android.lib.ad.LocalAdPlayActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RecommendProject" />

        <activity android:name="app.allever.android.lib.recommend.ui.RecommendListActivity"
            android:theme="@style/Theme.RecommendProject"/>
    </application>
</manifest>